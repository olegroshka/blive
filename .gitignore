# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
wheels/

# Test / coverage / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# blive runtime artefacts (artefact cache, run snapshots) — local only
.blive/

# uv lockfile is committed (uv recommends checking in uv.lock for apps)
# but cache and per-user files are not
.uv-cache/

# LaTeX build intermediates (the .tex source and the .pdf are tracked; the
# auxiliary files regenerate on every build)
*.aux
*.log
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.lof
*.lot

# Per ADR-035: secrets/*.env files hold real broker credentials and must
# NEVER enter git. Only the .example template files (and .gitkeep) are
# committed; real files live at ~/.blive/secrets/{broker}.env outside
# the repo. The repo-local secrets/ directory exists only to host the
# templates and demonstrate the schema.
secrets/*.env
!secrets/*.env.example

# Ad-hoc operator screenshots dropped under docs/. The naming pattern
# img*.png is reserved for transient communication artefacts that may
# leak account ids / sensitive UI state and must NOT enter git. Permanent
# documentation figures should live under docs/.../figures/ with a
# specific name (e.g. parity-residual-decomposition.png), not img*.png.
docs/img*.png
