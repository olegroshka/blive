# IB Paper / Gateway connection parameters for blive — TEMPLATE.
#
# Per ADR-035 (docs/decisions/DECISIONS.md#adr-035--secrets-handling-discipline-blivesecrets):
#   - Copy this file to ~/.blive/secrets/ib.env (NOT in this repo).
#   - IB itself authenticates via IB Gateway / TWS + IBC (no password here);
#     these values are connection parameters, not secrets per se. The schema
#     marks IB_PAPER_ACCOUNT_ID as secret because it identifies the account.
#   - Real .env files are gitignored; only this .example file is committed.
#
# This template is for the M2-IB path which is currently PARKED at the
# M2-substrate-IB.checkpoint commit; the file resumes its role when the
# IB Paper account reopens.

IB_HOST=127.0.0.1
IB_PORT=4002
# Default paper port: 4002 (gateway) or 7497 (TWS). Live ports differ.
IB_CLIENT_ID=1
# Pick a clientId for blive. Per KB-3 §4 the master client owns the orderId
# counter; blive runs as the master client for the account.
IB_PAPER_ACCOUNT_ID=replace-with-your-ib-paper-account-id
